[Unit]
Description=Low-priority CPU and resident-memory resource controller
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
DynamicUser=yes
StateDirectory=resource-guard
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 -u /opt/resource-guard/resource_guard.py
Environment=CPU_TARGET_PERCENT=25
Environment=MEMORY_TARGET_PERCENT=25
Environment=MEMORY_RESERVE_MIB=512
Environment=MAX_BALLAST_MIB=3584
Environment=WORKER_COUNT=2
Environment=STATUS_PATH=/var/lib/resource-guard/status.json
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=10
TimeoutStopSec=10
KillMode=control-group
OOMPolicy=kill
OOMScoreAdjust=500
Nice=19
CPUWeight=1
CPUQuota=80%
CPUAccounting=yes
MemoryAccounting=yes
MemoryHigh=3500M
MemoryMax=4G
MemorySwapMax=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
UMask=0077

[Install]
WantedBy=multi-user.target
